{
  "manifest_version": 3,
  "name": "AnkiVN - Muahaha",
  "version": "1.0",
  "description": "Thêm note vào Anki nhanh chóng.",
  "action": {
    "default_title": "Mở AnkiVN Sidebar"
  },
  "host_permissions": [
    "http://localhost:8765/"
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus" 
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html"
}