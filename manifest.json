{
  "manifest_version": 3,
  "name": "AnkiVN - Muahaha",
  "version": "2.0.0",
  "description": "Thêm note vào Anki nhanh chóng.",
  "action": {
    "default_title": "Mở AnkiVN Sidebar"
  },
  "host_permissions": [
    "http://localhost:8765/"
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/alt-selection.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "ui/popup.html"
  },
  "background": {
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "options_page": "ui/settings.html"
}